# Supabase — get these from Project Settings > API in your Supabase dashboard
# VITE_ prefix is required for Vite to expose them to the frontend
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Note: only the "anon" public key ever goes here. Never put the
# service_role key in a frontend .env — it bypasses Row Level Security
# and must only be used in a backend/server context.
